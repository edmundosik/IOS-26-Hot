vayu: 64 KB contiguous-hint GPU PTEs (pool BOs >= 64 KB start 64 KB-aligned); sweetgpucont=0 turns it off

diff --git a/bsd/dev/sweet_a6xx.c b/bsd/dev/sweet_a6xx.c
index fc1a59a..5ef4ed1 100644
--- a/bsd/dev/sweet_a6xx.c
+++ b/bsd/dev/sweet_a6xx.c
@@ -900,6 +900,10 @@ static uint64_t pt_walk(struct a6_gpu *g, uint64_t table, unsigned idx)
 	return t;
 }
 
+/* vayu: contiguous-hint PTEs (boot-arg sweetgpucont=0 turns it off, for A/B) */
+uint32_t a6_cont_hint = 1;
+uint64_t a6_mapped_4k, a6_mapped_cont;	/* 4K PTEs written, and how many of them with the hint */
+
 /* 4K entries for [iova, iova + n * 4K) taking the physical address of each 4K page from pa_of. */
 static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_of)(const void *, uint32_t),
 		  const void *arg)
@@ -917,6 +921,19 @@ static int map_4k(struct a6_gpu *g, uint64_t iova, uint32_t n4k, uint64_t (*pa_o
 		unsigned first = (va >> 12) & 0x1ff, k = 0;
 		while (first + k < 512 && i < n4k)
 			pte[k++] = pa_of(arg, i++) | (1u << 10) | (3u << 8) | (1u << 6) | 3u;
+		/* 64 KB-aligned runs of 16 contiguous pages get the contiguous hint: one TLB entry instead of 16 */
+		for (unsigned e = (first + 15) & ~15u; a6_cont_hint && e + 16 <= first + k; e += 16) {
+			uint64_t *p = &pte[e - first];
+			unsigned j = 1;
+			while (j < 16 && p[j] == p[0] + 0x1000ull * j)
+				j++;
+			if (j == 16 && !(p[0] & 0xf000ull)) {
+				for (j = 0; j < 16; j++)
+					p[j] |= 1ull << 52;
+				a6_mapped_cont += 16;
+			}
+		}
+		a6_mapped_4k += k;
 		a6_write(l3 + 8ull * first, pte, 8ull * k);
 	}
 	return 0;
