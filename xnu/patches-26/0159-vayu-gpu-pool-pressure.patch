diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index e4c6c6d..0906f9d 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -1094,6 +1094,33 @@ sweet_gpu_pool_avail(void)
 	}
 	return total - gpool_used;
 }
+
+/*
+ * Pressure on the pool, for NativeAdrenoParamsPoolPressure: less than sweetgpupressure MB (default 256) free, or an
+ * allocation refused or failed in the last two seconds. Each Turnip client then empties its BO cache, so memory one
+ * process cached is there for another (backboardd alone held 700 MB of the 944 while SpringBoard was refused).
+ */
+static uint64_t gpool_pressure_until;
+void sweet_gpu_pool_note_pressure(void);
+void
+sweet_gpu_pool_note_pressure(void)
+{
+	uint64_t span = 0;
+	nanoseconds_to_absolutetime(2000000000ULL, &span);
+	gpool_pressure_until = mach_absolute_time() + span;
+}
+bool sweet_gpu_pool_pressure(void);
+bool
+sweet_gpu_pool_pressure(void)
+{
+	static uint64_t low_bytes;
+	if (low_bytes == 0) {
+		uint32_t mb = 256;
+		PE_parse_boot_argn("sweetgpupressure", &mb, sizeof(mb));
+		low_bytes = ((uint64_t)mb << 20) | 1;
+	}
+	return sweet_gpu_pool_avail() < low_bytes || mach_absolute_time() < gpool_pressure_until;
+}
 static bool gpool_ready;
 static LCK_MTX_DECLARE(sweet_gpool_lock, &sweet_gpu_grp);
 
@@ -1149,6 +1176,7 @@ sweet_gpu_pool_alloc(uint64_t bytes, uint64_t *pa)
 	gpool_failures++;
 	uint64_t used = gpool_used;
 	lck_mtx_unlock(&sweet_gpool_lock);
+	sweet_gpu_pool_note_pressure();
 	a6_log("pool: no %llu bytes free (%llu MB in use)\n", size, used >> 20);
 	return -1;
 }
