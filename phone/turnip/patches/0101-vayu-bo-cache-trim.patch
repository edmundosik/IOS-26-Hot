+/* Called under retire->lock: the whole cache when the kernel pool is under pressure, else the entries idle too long. */
+static void
+darwin_cache_trim(struct tu_device *dev, struct darwin_retire_state *retire)
+{
+   if (!retire->cache_count)
+      return;
+   NativeAdrenoAbiParams params = {};
+   if (dw_call(NativeAdrenoMethodQuery, NULL, 0, &params, sizeof(params)) == KERN_SUCCESS &&
+       (params.flags & darwin_params_pool_pressure)) {
+      darwin_cache_flush(dev, retire);
+      return;
+   }
+   const uint64_t now = os_time_get_nano();
+   for (unsigned i = retire->cache_count; i-- > 0;)
+      if (now - retire->cache[i].cached_ns >= DARWIN_CACHE_IDLE_NS)
+         darwin_cache_evict(dev, retire, i);
+}
+
+/* Runs even while the client draws nothing, so an idle process does not keep pool memory another one needs. */
+static void *
+darwin_trim_main(void *arg)
+{
+   struct tu_device *dev = (struct tu_device *)arg;
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   pthread_mutex_lock(&retire->lock);
+   while (!retire->trim_stop) {
+      /* Darwin condition variables wait on the realtime clock. */
+      struct timespec ts;
+      clock_gettime(CLOCK_REALTIME, &ts);
+      uint64_t abs = (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec + DARWIN_TRIM_PERIOD_NS;
+      ts.tv_sec = abs / 1000000000ull;
+      ts.tv_nsec = abs % 1000000000ull;
+      pthread_cond_timedwait(&retire->trim_cond, &retire->lock, &ts);
+      if (retire->trim_stop || retire->failure != VK_SUCCESS)
+         continue;
+      darwin_cache_trim(dev, retire);
+   }
+   pthread_mutex_unlock(&retire->lock);
+   return NULL;
+}
