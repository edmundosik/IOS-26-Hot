+/// The part of `back` (each row of plane 0, then each row of plane 1, as `staging` plans them)
+/// inside `[x0, y0, x1, y1)`; `None` where it holds no texel.
+fn area_rows(back: &[vk::BufferCopy], [x0, y0, x1, y1]: [u32; 4]) -> Option<Vec<vk::BufferCopy>> {
+    let height = back.len() / 2;
+    let width = back.get(height)?.size;
+    let (x0, x1) = (u64::from(x0), u64::from(x1).min(width));
+    let (y0, y1) = (y0 as usize, (y1 as usize).min(height));
+    if x0 >= x1 || y0 >= y1 {
+        return None;
+    }
+    let cut = |row: &vk::BufferCopy, texel: u64| vk::BufferCopy {
+        src_offset: row.src_offset + x0 * texel,
+        dst_offset: row.dst_offset + x0 * texel,
+        size: (x1 - x0) * texel,
+    };
+    let color = back[y0..y1].iter().map(|row| cut(row, 4));
+    let alpha = back[height + y0..height + y1].iter().map(|row| cut(row, 1));
+    Some(color.chain(alpha).collect())
+}
+
+#[cfg(test)]
+mod area_tests {
+    use super::{area_rows, TwoPlaneHeapLayout};
+    use ash::vk;
+
+    #[test]
+    fn area_rows_cut_both_planes() {
+        let layout = TwoPlaneHeapLayout::of([8, 4]);
+        let back: Vec<_> = layout
+            .rows()
+            .map(|(row, size)| vk::BufferCopy {
+                src_offset: row,
+                dst_offset: 1000 + row,
+                size,
+            })
+            .collect();
+        let part = area_rows(&back, [2, 1, 5, 3]).unwrap();
+        assert_eq!(part.len(), 4);
+        assert_eq!((part[0].src_offset, part[0].dst_offset, part[0].size), (32 + 8, 1032 + 8, 12));
+        assert_eq!(part[1].src_offset, 64 + 8);
+        let a = layout.alpha_at;
+        assert_eq!((part[2].src_offset, part[2].dst_offset, part[2].size), (a + 16 + 2, 1000 + a + 18, 3));
+        assert_eq!(part[3].src_offset, a + 32 + 2);
+        assert!(area_rows(&back, [3, 0, 3, 4]).is_none());
+        assert_eq!(area_rows(&back, [0, 0, 99, 99]).unwrap().len(), 8);
+        assert_eq!(area_rows(&back, [0, 0, 99, 99]).unwrap()[0].size, 32);
+    }
+}
