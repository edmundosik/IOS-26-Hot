+/// SweetMetal2 (vayu): HOT_MTL2_SHADOW_KEEP=1 keeps a shadow the GPU wrote current across encoders:
+/// its copy in is skipped while no copy back of another shadow (or a write the encoder saw) changed
+/// its truth's bytes since its image last matched them. CPU writes to such bytes are not seen.
+/// shortcut: process-global tables that never shrink and see no CPU writes; upgrade to per-buffer
+/// state with the buffer's CPU-access hooks if the A/B shows the copies matter.
+mod keep {
+    use super::{ResourceKey, ShadowCopies};
+    use std::collections::HashMap;
+    use std::sync::{Mutex, OnceLock};
+
+    #[derive(Default)]
+    struct State {
+        epochs: HashMap<ResourceKey, u64>,
+        synced: HashMap<ResourceKey, (u64, bool)>,
+    }
+    static STATE: Mutex<Option<State>> = Mutex::new(None);
+
+    pub(super) fn on() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("HOT_MTL2_SHADOW_KEEP").is_some())
+    }
+
+    fn epoch(state: &State, copies: &ShadowCopies) -> u64 {
+        let truth = state.epochs.get(&copies.truth().0).copied().unwrap_or(0);
+        let alias = copies.alias().and_then(|key| state.epochs.get(&key).copied()).unwrap_or(0);
+        truth.wrapping_add(alias)
+    }
+
+    fn with<T>(f: impl FnOnce(&mut State) -> T) -> T {
+        let mut guard = STATE.lock().unwrap_or_else(|e| e.into_inner());
+        f(guard.get_or_insert_with(State::default))
+    }
+
+    /// The truth's bytes changed (a copy back, or another write the encoder saw).
+    pub(super) fn bump(copies: &ShadowCopies) {
+        with(|state| {
+            for key in [Some(copies.truth().0), copies.alias()].into_iter().flatten() {
+                *state.epochs.entry(key).or_insert(0) += 1;
+            }
+        });
+    }
+
+    /// The shadow's image now matches its truth; `written`: the GPU wrote it (a copy back).
+    pub(super) fn synced(copies: &ShadowCopies, written: bool) {
+        with(|state| {
+            let now = epoch(state, copies);
+            let entry = state.synced.entry(copies.shadow_key).or_insert((now, false));
+            *entry = (now, entry.1 || written);
+        });
+    }
+
+    /// Whether the GPU wrote the shadow and its image still matches its truth.
+    pub(super) fn current(copies: &ShadowCopies) -> bool {
+        with(|state| {
+            let now = epoch(state, copies);
+            matches!(state.synced.get(&copies.shadow_key), Some(&(at, true)) if at == now)
+        })
+    }
+}
