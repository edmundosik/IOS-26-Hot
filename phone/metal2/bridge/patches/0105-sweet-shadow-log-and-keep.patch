diff --git a/crates/metal2vulkan-runtime/src/dispatch_log.rs b/crates/metal2vulkan-runtime/src/dispatch_log.rs
new file mode 100644
index 000000000..b1d97b0e4
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/dispatch_log.rs
@@ -0,0 +1,26 @@
+//! SweetMetal2 (vayu): HOT_MTL2_LOG_COMPUTE=1 counts compute dispatches recorded by each of the runtime's
+//! paths (Metal's own and the internal ones: mipmaps, two-plane surfaces, merges...) and prints them every 5 s,
+//! to name the 0.6-8.6 ms compute passes of backboardd that its Metal code never dispatches (log92/log93).
+//! shortcut: counts workgroups, not GPU time; upgrade to timestamp queries per site if two sites look alike.
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+pub(crate) fn note(site: &'static str, groups: u64) {
+    static ON: OnceLock<bool> = OnceLock::new();
+    if !*ON.get_or_init(|| std::env::var_os("HOT_MTL2_LOG_COMPUTE").is_some()) {
+        return;
+    }
+    static STATE: Mutex<Option<(Instant, HashMap<&'static str, (u64, u64)>)>> = Mutex::new(None);
+    let mut state = STATE.lock().unwrap_or_else(|e| e.into_inner());
+    let (since, sites) = state.get_or_insert_with(|| (Instant::now(), HashMap::new()));
+    let entry = sites.entry(site).or_insert((0, 0));
+    entry.0 += 1;
+    entry.1 += groups;
+    if since.elapsed().as_secs() >= 5 {
+        let line: Vec<String> = sites.iter().map(|(s, (n, g))| format!("{s} n{n} groups {g}")).collect();
+        eprintln!("m2v dispatch 5s: {}", line.join(", "));
+        sites.clear();
+        *since = Instant::now();
+    }
+}
